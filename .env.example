# Variables de entorno recomendadas para Don Rutero
# Copia este archivo a .env (el .env real no debe subirse al repositorio)

# Base de datos MySQL
DB_URL=jdbc:mysql://localhost:3306/ruta_bus_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Seguridad JWT (mínimo 32 caracteres aleatorios en despliegue)
JWT_SECRET=GENERA_UNA_CLAVE_ALEATORIA_MINIMO_32_CARACTERES
ADMIN_DEFAULT_PASSWORD=GENERA_UNA_CLAVE_SEGURA_PARA_ADMIN

# Producción: define tus orígenes permitidos reales y desactiva códigos demo
# SPRING_PROFILES_ACTIVE=prod
# CORS_ALLOWED_ORIGINS=https://tudominio.com
# EXPOSE_DEMO_CODES=false
# JPA_DDL_AUTO=validate
